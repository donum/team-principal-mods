# Team review site: only index.php, api.php, app.js and app.css are served.
Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(lib|config|config\.sample)\.php$|\.(sqlite|sqlite-wal|sqlite-shm|json|md|tsv)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Larger uploads for the data file (about 3 MB). Ignored where PHP runs as CGI;
# there the .user.ini next to this file sets the same.
<IfModule mod_php.c>
    php_value upload_max_filesize 16M
    php_value post_max_size 20M
</IfModule>
